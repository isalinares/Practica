# MongoDB
MONGO_URI=mongodb://mongo:27017/pokemon_battle
PORT=4000

# Clerk - Obtén estas claves en https://dashboard.clerk.com
# Ve a API Keys y copia la Secret Key
CLERK_SECRET_KEY=sk_test_your_clerk_secret

# Stripe - Obtén estas claves en https://dashboard.stripe.com
# Ve a Developers > API keys para las claves secretas
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# Webhook Secret - Obténlo después de crear el webhook en Stripe
# Ejecuta 'stripe listen --forward-to localhost:4000/api/payments/webhook' para desarrollo
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Price ID del producto Shiny en Stripe
# Crea un producto en Stripe y copia el Price ID
STRIPE_SHINY_PRICE_ID=price_your_shiny_price_id

# Clerk - Publishable Key (Frontend)
# Crea una aplicación en Clerk y copia las claves de API
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable

# Backend API URL
VITE_API_URL=http://localhost:4000
